#!/bin/sh
# Post-install hook, shared by the .deb and the .rpm. dpkg and rpm pass
# different arguments, so nothing here reads $1; every step is safe to re-run.

set -e

# The account the service runs as. No home, no login shell.
if ! getent group esp32ir >/dev/null; then
    groupadd --system esp32ir
fi

if ! getent passwd esp32ir >/dev/null; then
    useradd --system --no-create-home --shell /usr/sbin/nologin \
            --gid esp32ir --comment "ESP32 IR Remote daemon" esp32ir
fi

# Re-applies the rule to a stick that is already plugged in. Replugging does
# the same, so a failure here is not fatal.
if command -v udevadm >/dev/null; then
    udevadm control --reload-rules || true
    udevadm trigger --subsystem-match=hidraw --subsystem-match=usb --action=add || true
fi

if command -v systemctl >/dev/null; then
    systemctl daemon-reload || true

    # Starting the daemon on an already-running system does not touch the TV:
    # the boot ON is only sent in the first three minutes after boot.
    systemctl enable --now esp32-ir-remote.service || true
fi

exit 0

#!/bin/sh
# Pre-removal hook, shared by the .deb and the .rpm. Stops the service only on a
# real removal, not the removal half of an upgrade.
#   dpkg: "remove", or "upgrade <version>"      rpm: 0 = remove, 1 = upgrade

set -e

case "$1" in
    remove|0)
        if command -v systemctl >/dev/null; then
            systemctl disable --now esp32-ir-remote.service || true
        fi
        ;;
esac

# The esp32ir account is left behind on purpose. Remove it by hand if wanted:
#   sudo userdel esp32ir && sudo groupdel esp32ir

exit 0

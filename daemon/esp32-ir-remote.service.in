# Template: CMake fills in @CMAKE_INSTALL_FULL_BINDIR@. Edit this file, never
# the generated one.

[Unit]
Description=ESP32 IR Remote Daemon
# dbus.socket as well as logind, or the daemon can beat the system bus at boot,
# fail, and only recover on the next restart, turning the TV on late.
After=dbus.socket systemd-logind.service
Requires=systemd-logind.service

[Service]
Type=simple
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/esp32-ir-daemon
Restart=on-failure
RestartSec=5

# Unprivileged. 99-esp32-ir-remote.rules gives the esp32ir group the device.
User=esp32ir
Group=esp32ir

# --- Sandboxing ---
# The daemon reads no files, writes nothing and uses no network.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
# AF_UNIX for D-Bus; AF_NETLINK for the udev watch. Without AF_NETLINK nothing
# fails loudly: the daemon starts, logs one line, and loses the ON at boot.
RestrictAddressFamilies=AF_UNIX AF_NETLINK
# Limits device access to hidraw, usb_device (for the reset on wake) and the
# standard pseudo-devices.
DeviceAllow=char-hidraw rw
DeviceAllow=char-usb_device rw

[Install]
WantedBy=multi-user.target
